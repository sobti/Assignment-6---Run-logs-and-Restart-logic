# packed/, stats/ are hundreds of MB combined; checkpoints_tt/ alone is
# ~700MB of .pt weight files). All fully regenerable by running
# ./run_pipeline.sh -- see README.md.
routed/
shards/
packed/
checkpoints/
checkpoints_tt/
stats/



# Python environment -- never commit, recreate with:
#   python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
.venv/
__pycache__/
*.pyc

# Generated corpus + intermediate pipeline artifacts (routed/, shards/,
# packed/, stats/ are hundreds of MB combined). All fully regenerable by
# running ./run_pipeline.sh -- see README.md.
routed/
shards/
packed/
stats/

# submission_artifacts/: only the small top-level audit outputs (run.log,
# evidence.json, evidence.md, performance.json) are committed -- the
# manifests/ledgers/checkpoints subfolders are regenerable pipeline output
# (checkpoints/ alone is hundreds of MB of .pt weight files).
#submission_artifacts/manifests/
#submission_artifacts/ledgers/
submission_artifacts/checkpoints/


# macOS Finder junk
.DS_Store
